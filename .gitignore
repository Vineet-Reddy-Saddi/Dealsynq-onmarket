# Data artefacts — far too large for git (listings.db ~180MB, details.db ~2GB).
# Host listings.db as a release asset and point DB_URL at it (see DEPLOY.md).
data/*.csv
data/_stage/
data/_cache/
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log
data/_*.log
# ...but demographics.db (~22MB) IS committed. It is small enough for git, and keeping
# it in the repo means the deploy needs no third release asset and no extra env var --
# server.py picks it up from the working tree. Rebuilt only when Census publishes a new
# ACS vintage (annually), so it does not churn history.
!data/demographics.db
# Cached Census source files for scripts/build_demographics.py (~120MB of ACS .dat)
data/_census_cache/
webapp/listings.db
webapp/listings.db-wal
webapp/listings.db-shm
# slim deploy copy of details.db (scripts/build_deploy_details.py); hosted as a
# release asset, not committed
webapp/details_deploy.db

# Python
__pycache__/
*.pyc
.venv/
venv/
